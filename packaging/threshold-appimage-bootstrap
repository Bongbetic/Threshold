#!/bin/sh
# Threshold AppImage EC bootstrap authority (issue #86).
#
# The one-time, explicitly user-initiated privileged entry point for the
# AppImage. Run under fresh Polkit authorization (pkexec) per mutation.
# It installs the fixed, root-owned EC lifecycle authority and its boot
# reconciler unit from the AppImage's embedded, streamed EC bundle; no
# privileged daemon remains running and no reusable privilege is retained.
#
# Verbs (one non-cached administrator authorization per gesture):
#   install | update | repair | remove
#
# Input: the embedded EC bundle is streamed on stdin (canonical manifest
# + msi-ec source tarball). Caller-selected paths are never accepted.
set -u

# Overridable for fake-system verification; installed contract is default.
AUTHORITY_DIR=${THRESHOLD_AUTHORITY_DIR:-/var/lib/threshold/authority}
AUTHORITY_BIN=${THRESHOLD_AUTHORITY_BIN:-/usr/sbin/threshold-ec-lifecycle}
AUTHORITY_UNIT=${THRESHOLD_AUTHORITY_UNIT:-/usr/lib/systemd/system/threshold-boot-reconcile.service}
TRUST_PUB=${THRESHOLD_TRUST_PUB:-/usr/share/threshold/trust/threshold-ec-trust.pub}
EC_STATE_DIR=${THRESHOLD_EC_STATE_DIR:-/var/lib/threshold/ec}
PACKAGE_OWNED_MARKER=$EC_STATE_DIR/package-owned
STAGING=$AUTHORITY_DIR/staging

# Protocol compatibility: the bundle stream begins with a canonical JSON
# manifest line; the appimage embeds the matching protocol version.
PROTOCOL=1
MAX_BUNDLE_BYTES=$((16 * 1024 * 1024))

fail() {
    echo "threshold-appimage-bootstrap: $*" >&2
    exit 1
}

# ── Recovery: clean interrupted state and restore last-known-good (issue #91)

cleanup_interrupted_state() {
    # Remove orphaned staging from a previous interrupted bootstrap.
    if [ -d "$STAGING" ]; then
        echo "threshold-appimage-bootstrap: cleaning orphaned staging" >&2
        rm -rf "$STAGING"
    fi
}

recover_last_known_good() {
    # If the installed authority is broken after a failed replacement,
    # restore the last-known-good Threshold-managed asset.  Never resume
    # an interrupted authorized upgrade — only clean or restore.
    local lkg="$AUTHORITY_DIR/threshold-ec-lifecycle.last-known-good"
    if [ -x "$AUTHORITY_BIN" ] && sh -n "$AUTHORITY_BIN" 2>/dev/null; then
        return 0  # authority is functional, nothing to recover
    fi
    if [ -r "$lkg" ]; then
        echo "threshold-appimage-bootstrap: restoring last-known-good authority" >&2
        cp -f "$lkg" "$AUTHORITY_BIN"
        chmod 0755 "$AUTHORITY_BIN"
    else
        echo "threshold-appimage-bootstrap: no last-known-good available for recovery" >&2
    fi
}

fsync_path() {
    # fsync a file to durable storage (issue #91).
    if command -v python3 >/dev/null 2>&1; then
        python3 -c "
import os, sys
try:
    f = os.open(sys.argv[1], os.O_RDWR)
    os.fsync(f)
    os.close(f)
except OSError:
    pass
" "$1" 2>/dev/null || :
    fi
}

case "${1:-}" in
    install|update|repair)
        cleanup_interrupted_state
        ;;
    remove)
        # Remove the provider claim; shared operational assets are removed
        # by the authority's own ledger logic (package ownership respected).
        if [ -x "$AUTHORITY_BIN" ]; then
            "$AUTHORITY_BIN" remove || :
        fi
        if [ -x /usr/bin/systemctl ]; then
            systemctl disable --now threshold-boot-reconcile.service >/dev/null 2>&1 || :
        fi
        rm -f "$AUTHORITY_UNIT"
        rm -rf "$AUTHORITY_DIR"
        exit 0
        ;;
    *)
        echo "usage: $0 {install|update|repair|remove}" >&2
        exit 2
        ;;
esac

# ── Receive and validate the streamed bundle ───────────────────────────────
mkdir -p "$STAGING" || fail "cannot create staging area"

# Size bound before mutation: capture the whole stream, then bound it.
cat > "$STAGING/stream" || fail "bundle stream unreadable"
SIZE=$(wc -c < "$STAGING/stream")
[ "$SIZE" -le "$MAX_BUNDLE_BYTES" ] || fail "bundle exceeds input-size bound"

MANIFEST_FILE=$STAGING/manifest.json
head -n 1 "$STAGING/stream" > "$MANIFEST_FILE" || fail "bundle manifest missing"
tail -n +2 "$STAGING/stream" > "$STAGING/bundle.tar.gz" || fail "bundle payload missing"

# Canonical manifest + protocol + architecture + checksum compatibility.
command -v python3 >/dev/null 2>&1 || fail "python3 required for bundle validation"
python3 - "$MANIFEST_FILE" "$PROTOCOL" <<'PYEOF' || fail "bundle manifest rejected"
import json, sys
manifest = json.loads(open(sys.argv[1]).read())
assert manifest.get("protocol") == int(sys.argv[2]), "protocol mismatch"
assert manifest.get("arch") == "x86_64", "architecture mismatch"
assert manifest.get("schema") == 1, "manifest schema mismatch"
for key in ("lifecycle", "dkms", "checksum", "bundle_checksum", "signature", "sequence"):
    assert key in manifest, f"manifest missing {key}"
PYEOF

# Payload authenticity: the streamed bundle must match the manifest's
# declared checksum before any mutation.
BUNDLE_SHA=$(sha256sum "$STAGING/bundle.tar.gz" | awk '{print $1}')
python3 - "$MANIFEST_FILE" "$BUNDLE_SHA" <<'PYEOF' || fail "bundle checksum mismatch"
import json, sys
manifest = json.load(open(sys.argv[1]))
assert manifest["bundle_checksum"] == sys.argv[2], "payload does not match manifest"
PYEOF

# Package-owned authority is never overwritten by the AppImage: an
# installed DEB or Unified RPM owns /usr/sbin/threshold-ec-lifecycle.
# A compatible package-owned authority is reused; an incompatible one
# produces update guidance rather than overwrite.
if [ -e "$PACKAGE_OWNED_MARKER" ]; then
    # Check if the existing authority is compatible (same protocol).
    EXISTING_PROTOCOL=""
    if [ -r "$AUTHORITY_DIR/active-manifest.json" ]; then
        EXISTING_PROTOCOL=$(python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get('protocol',''))" "$AUTHORITY_DIR/active-manifest.json" 2>/dev/null || :)
    fi
    BUNDLE_PROTOCOL=$(python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get('protocol',''))" "$MANIFEST_FILE" 2>/dev/null || :)
    if [ "$EXISTING_PROTOCOL" = "$BUNDLE_PROTOCOL" ]; then
        # Compatible: reuse the existing package-owned authority.
        echo "threshold-appimage-bootstrap: compatible package-owned authority found; reusing." >&2
    else
        # Incompatible: produce guidance, do not overwrite.
        fail "incompatible package-owned EC authority present (protocol $EXISTING_PROTOCOL vs $BUNDLE_PROTOCOL); update the package instead"
    fi
fi

# ── Trust: Ed25519 signature + monotonic sequence (issue #86) ──────────────
[ -r "$TRUST_PUB" ] || fail "pinned Threshold trust key missing"
command -v openssl >/dev/null 2>&1 || fail "openssl required for trust verification"

# Canonical encoding: strip the signature field, re-canonicalize, verify.
CANON=$STAGING/manifest.canon
SIG=$STAGING/manifest.sig
python3 - "$MANIFEST_FILE" "$CANON" "$SIG" <<'PYEOF' || fail "bundle trust rejected"
import base64, json, sys
m = json.load(open(sys.argv[1]))
sig = m.pop("signature", None)
assert sig, "manifest is not signed"
seq = m.get("sequence")
assert isinstance(seq, int) and seq >= 0, "manifest sequence missing/invalid"
open(sys.argv[2], "wb").write(
    json.dumps(m, sort_keys=True, indent=1, separators=(",", ": ")).encode()
)
open(sys.argv[3], "wb").write(base64.b64decode(sig))
PYEOF

openssl pkeyutl -verify -pubin -inkey "$TRUST_PUB" -rawin \
    -in "$CANON" -sigfile "$SIG" >/dev/null 2>&1 \
    || fail "manifest signature failed against pinned Threshold trust"

# Ordinary downgrades are refused: the sequence must be strictly newer
# than the active bundle's sequence (first install has no active record).
ACTIVE_MANIFEST=$AUTHORITY_DIR/active-manifest.json
if [ -r "$ACTIVE_MANIFEST" ]; then
    python3 - "$MANIFEST_FILE" "$ACTIVE_MANIFEST" <<'PYEOF' || fail "downgrade refused"
import json, sys
new = json.load(open(sys.argv[1]))["sequence"]
old = json.load(open(sys.argv[2])).get("sequence", 0)
assert new > old, f"sequence {new} not newer than active {old}"
PYEOF
fi

# ── Install / replace the authority atomically ────────────────────────────
mkdir -p "$AUTHORITY_DIR"
TMP_BIN=$AUTHORITY_DIR/threshold-ec-lifecycle.new

# Preserve the currently active engine as last-known-good BEFORE switching.
if [ -f "$AUTHORITY_BIN" ]; then
    cp -f "$AUTHORITY_BIN" "$AUTHORITY_DIR/threshold-ec-lifecycle.last-known-good"
fi

# Extract bundle payload to a clean subdirectory for inventory verification.
PAYLOAD_DIR=$STAGING/payload
mkdir -p "$PAYLOAD_DIR"
tar -xzf "$STAGING/bundle.tar.gz" -C "$PAYLOAD_DIR" || fail "bundle payload invalid"

# ── Complete inventory verification (issue #97) ───────────────────────────
# The manifest declares a complete inventory of normalized regular files.
# Verify: all declared files are present, no extras, all regular, safe
# modes, and per-file hash integrity — before any mutation.
python3 - "$MANIFEST_FILE" "$PAYLOAD_DIR" <<'PYEOF' || fail "bundle inventory rejected"
import hashlib, json, os, stat, sys

manifest = json.load(open(sys.argv[1]))
payload_dir = sys.argv[2]
inventory = manifest.get("inventory", [])

# Build the set of declared paths.
declared = {item["path"] for item in inventory}
# Build the set of actual paths in the extracted payload.
actual = set()
for root, dirs, files in os.walk(payload_dir):
    for name in files:
        full = os.path.join(root, name)
        rel = os.path.relpath(full, payload_dir)
        actual.add(rel)

# No extra files beyond what the manifest declares.
extras = actual - declared
if extras:
    sys.exit(f"bundle contains undeclared extra files: {extras}")

# No missing files: every declared path must exist.
missing = declared - actual
if missing:
    sys.exit(f"bundle is missing declared inventory files: {missing}")

# Verify each declared file: regular, safe mode, correct hash.
for item in inventory:
    path = item["path"]
    full = os.path.join(payload_dir, path)
    # Check declared type matches actual file type.
    declared_type = item.get("type", "regular")
    if declared_type != "regular":
        sys.exit(f"inventory entry {path} has non-regular type: {declared_type}")
    if not os.path.isfile(full):
        sys.exit(f"inventory entry {path} is not a regular file")
    st = os.stat(full)
    # Reject setuid, setgid, or sticky bits.
    # Check the declared mode in the inventory, not just the actual file mode.
    declared_mode = item.get("mode", "")
    if declared_mode:
        try:
            mode_int = int(declared_mode, 8)
            unsafe_declared = mode_int & (stat.S_ISUID | stat.S_ISGID | stat.S_ISVTX)
            if unsafe_declared:
                sys.exit(f"inventory entry {path} declares unsafe mode {declared_mode}")
        except ValueError:
            pass  # Invalid mode string; let the actual file check catch issues
    # Also check actual file mode for safety.
    unsafe = st.st_mode & (stat.S_ISUID | stat.S_ISGID | stat.S_ISVTX)
    if unsafe:
        sys.exit(f"inventory entry {path} has unsafe actual mode {oct(st.st_mode)}")
    # Verify size.
    if st.st_size != item.get("size", st.st_size):
        sys.exit(f"inventory entry {path} size mismatch: {st.st_size} != {item.get('size')}")
    # Verify sha256.
    with open(full, "rb") as f:
        computed = hashlib.sha256(f.read()).hexdigest()
    if computed != item.get("sha256", computed):
        sys.exit(f"inventory entry {path} hash mismatch: {computed} != {item.get('sha256')}")
PYEOF

# Copy the lifecycle script from the verified payload to the staging area
# for offline validation.
cp "$PAYLOAD_DIR/lifecycle" "$STAGING/lifecycle" || fail "bundle payload missing lifecycle"

# Offline validation before switching the active record: the staged
# lifecycle script must parse and declare the manifest's DKMS identity.
sh -n "$STAGING/lifecycle" || fail "staged lifecycle script malformed"
grep -q "$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["dkms"]["name"])' "$MANIFEST_FILE")" \
    "$STAGING/lifecycle" || fail "staged lifecycle does not match bundle identity"

install -Dpm 0755 "$STAGING/lifecycle" "$TMP_BIN"
fsync_path "$TMP_BIN"
mkdir -p "$(dirname "$AUTHORITY_BIN")"
mv -f "$TMP_BIN" "$AUTHORITY_BIN"
chmod 0755 "$AUTHORITY_BIN"

install -Dpm 0644 \
    "$(dirname "$0")/../share/threshold/threshold-boot-reconcile.service" \
    "$AUTHORITY_UNIT" 2>/dev/null || \
    install -Dpm 0644 /usr/share/threshold/threshold-boot-reconcile.service "$AUTHORITY_UNIT" || \
    fail "boot reconciler unit missing"

# Keep the accepted bundle for evidence retention (bounded).
cp -f "$MANIFEST_FILE" "$AUTHORITY_DIR/active-manifest.json"
fsync_path "$AUTHORITY_DIR/active-manifest.json"
rm -rf "$STAGING"

# ── Structured protocol output (issue #97) ────────────────────────────────
# Emit a structured JSON result on stdout for the calling application.
# Exit classes: success, pending_reboot, refusal, cancellation, busy,
# validation_failure, operation_failure, rollback_failure.
emit_result() {
    python3 -c "
import json, sys
print(json.dumps({
    'protocol': 1,
    'operation': sys.argv[1],
    'result': sys.argv[2],
    'message': sys.argv[3] or None,
    'ec_setup_state': sys.argv[4] or None,
    'reason': sys.argv[5] or None,
    'maintenance': sys.argv[6],
}, sort_keys=True, indent=2))
" "$@"
}

# Hand over to the installed authority for the actual EC work; the
# bootstrap's install/update gestures map onto the lifecycle's
# idempotent install-or-upgrade operation.
case "$1" in
    install|update) VERB=install-or-upgrade ;;
    *) VERB=$1 ;;
esac
"$AUTHORITY_BIN" "$VERB" 2>&1
AUTH_EXIT=$?

# Determine EC state from the lifecycle's output.
EC_STATE=""
EC_REASON=""
if [ -f "$EC_STATE_DIR/state" ]; then
    EC_STATE=$(grep -o '^setup_state=.*' "$EC_STATE_DIR/state" 2>/dev/null | cut -d= -f2)
    EC_REASON=$(grep -o '^reason=.*' "$EC_STATE_DIR/state" 2>/dev/null | cut -d= -f2)
fi

if [ "$AUTH_EXIT" -ne 0 ]; then
    recover_last_known_good || :
    # Distinguish exit classes from the authority's exit code.
    case "$AUTH_EXIT" in
        1)  emit_result "$1" "busy" "another mutation is in progress" "$EC_STATE" "$EC_REASON" "ok" ;;
        2)  emit_result "$1" "validation_failure" "bundle validation failed" "$EC_STATE" "$EC_REASON" "ok" ;;
        *)  emit_result "$1" "operation_failure" "authority failed (exit $AUTH_EXIT)" "$EC_STATE" "$EC_REASON" "ok" ;;
    esac
    exit "$AUTH_EXIT"
fi

# Success: determine the specific result class from EC state.
case "$EC_STATE" in
    available)
        emit_result "$1" "success" "EC setup available" "available" "" "ok"
        ;;
    pending_reboot)
        emit_result "$1" "pending_reboot" "EC setup pending reboot" "pending_reboot" "" "ok"
        ;;
    unavailable)
        emit_result "$1" "success" "EC setup unavailable ($EC_REASON)" "unavailable" "$EC_REASON" "ok"
        ;;
    *)
        emit_result "$1" "success" "bootstrap completed" "$EC_STATE" "$EC_REASON" "ok"
        ;;
esac
exit 0