#!/bin/sh
# Threshold DEB configure hook (issue #86).
# The shared EC lifecycle authority owns all EC behavior; this hook only
# invokes it and never fails the transaction on EC outcomes.
# systemd enable/disable is handled by dh_installsystemd.
set -e

case "$1" in
    configure)
        # Marker: a package owns this authority; the AppImage bootstrap
        # must never overwrite a package-owned EC authority.
        mkdir -p /var/lib/threshold/ec
        touch /var/lib/threshold/ec/package-owned
        if [ -x /usr/sbin/threshold-ec-lifecycle ]; then
            /usr/sbin/threshold-ec-lifecycle install-or-upgrade || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
