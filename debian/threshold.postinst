#!/bin/sh
set -e

case "$1" in
    configure)
        MSI_EC_VER="0.13.112"
        DKMS_FAILED=0
        if command -v dkms >/dev/null 2>&1; then
            # clean stale 0.13 tree left by threshold <=1.4.0
            dkms remove -m msi-ec -v 0.13 --all 2>/dev/null || true
            rm -rf /usr/src/msi-ec-0.13 2>/dev/null || true
            echo "Threshold: DKMS add/build/install msi-ec $MSI_EC_VER ..." >&2
            if ! dkms add -m msi-ec -v "$MSI_EC_VER" 2>&1 | tee /tmp/threshold-dkms.log; then
                echo "Threshold: dkms add failed (see /tmp/threshold-dkms.log)" >&2
                DKMS_FAILED=1
            fi
            if [ "$DKMS_FAILED" -eq 0 ] && ! dkms build -m msi-ec -v "$MSI_EC_VER" 2>&1 | tee -a /tmp/threshold-dkms.log; then
                echo "Threshold: dkms build failed (see /tmp/threshold-dkms.log)" >&2
                DKMS_FAILED=1
            fi
            if [ "$DKMS_FAILED" -eq 0 ] && ! dkms install -m msi-ec -v "$MSI_EC_VER" 2>&1 | tee -a /tmp/threshold-dkms.log; then
                echo "Threshold: dkms install failed (see /tmp/threshold-dkms.log)" >&2
                DKMS_FAILED=1
            fi
            if [ "$DKMS_FAILED" -ne 0 ]; then
                mkdir -p /var/lib/threshold
                echo "DKMS build/install failed for msi-ec $MSI_EC_VER on $(date -Iseconds)" > /var/lib/threshold/install-warnings
                cat /tmp/threshold-dkms.log >> /var/lib/threshold/install-warnings 2>/dev/null || true
                echo "Threshold: EC control unavailable — app will run in notification-only mode." >&2
                echo "Threshold: On Secure Boot systems, enroll the MOK key:" >&2
                echo "  sudo mokutil --import /var/lib/shim-signed/mok/mok.pub && reboot" >&2
            fi
        else
            echo "Threshold: dkms not found — cannot build msi-ec module." >&2
            mkdir -p /var/lib/threshold
            echo "dkms not found on $(date -Iseconds)" > /var/lib/threshold/install-warnings
        fi
        mkdir -p /usr/lib/modules-load.d
        echo msi-ec > /usr/lib/modules-load.d/msi-ec.conf
        if ! modprobe msi-ec 2>&1 | tee /tmp/threshold-modprobe.log; then
            echo "Threshold: modprobe msi-ec failed — check 'dmesg | grep msi_ec' and firmware support." >&2
            mkdir -p /var/lib/threshold
            echo "modprobe msi-ec failed on $(date -Iseconds)" >> /var/lib/threshold/install-warnings
            cat /tmp/threshold-modprobe.log >> /var/lib/threshold/install-warnings 2>/dev/null || true
            if dmesg 2>/dev/null | grep -q "Your firmware version is not supported"; then
                echo "Threshold: msi-ec reports 'firmware not supported' — this msi-ec version lacks your EC firmware." >> /var/lib/threshold/install-warnings
                echo "Threshold: Try: sudo modprobe msi-ec firmware=16RKIMS1.111 (fallback) or update msi-ec." >&2
            fi
        fi
        udevadm control --reload-rules || true
        udevadm trigger --subsystem-match=power_supply || true
        ;;
esac

exit 0
