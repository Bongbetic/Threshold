#!/bin/sh
# Threshold DEB removal hook (issue #86).
# Removal invokes lifecycle removal before files disappear; upgrade paths
# never reach this hook destructively (dpkg calls prerm with remove only
# on actual removal, not upgrade, where the new postinst re-runs setup).
# systemd stop/disable is handled by dh_installsystemd.
set -e

case "$1" in
    remove)
        if [ -x /usr/sbin/threshold-ec-lifecycle ]; then
            /usr/sbin/threshold-ec-lifecycle remove || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
