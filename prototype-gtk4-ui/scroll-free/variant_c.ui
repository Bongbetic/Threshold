<?xml version="1.0" encoding="UTF-8"?>
<!-- Variant C — Compact single-page: tight spacing, no clamp, dense layout -->
<interface>
  <object class="GtkBox" id="root">
    <property name="orientation">vertical</property>
    <child>
      <object class="AdwHeaderBar">
        <property name="title-widget">
          <object class="AdwWindowTitle">
            <property name="title" translatable="yes">Threshold</property>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <property name="margin-top">12</property>
        <property name="margin-bottom">12</property>
        <property name="margin-start">16</property>
        <property name="margin-end">16</property>
        <property name="vexpand">True</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="homogeneous">True</property>
            <property name="spacing">8</property>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">2</property>
                <style><class name="card"/></style>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Current Charge</property>
                    <style>
                      <class name="dim-label"/>
                      <class name="caption"/>
                    </style>
                    <property name="xalign">0</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">72%</property>
                    <style><class name="title-2"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">⚡ Charging</property>
                    <style>
                      <class name="dim-label"/>
                      <class name="caption"/>
                    </style>
                    <property name="xalign">0</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">2</property>
                <style><class name="card"/></style>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Active Threshold</property>
                    <style>
                      <class name="dim-label"/>
                      <class name="caption"/>
                    </style>
                    <property name="xalign">0</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">80%</property>
                    <style><class name="title-2"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">BAT1</property>
                    <style>
                      <class name="dim-label"/>
                      <class name="caption"/>
                    </style>
                    <property name="xalign">0</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">8</property>
            <style><class name="card"/></style>
            <child>
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">8</property>
                <property name="valign">center</property>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Charge Limit</property>
                    <style><class name="heading"/></style>
                    <property name="hexpand">True</property>
                    <property name="xalign">0</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">80%</property>
                    <style><class name="title-2"/></style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">8</property>
                <child>
                  <object class="GtkLabel">
                    <property name="label">20</property>
                    <style>
                      <class name="dim-label"/>
                      <class name="caption"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkScale">
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">20</property>
                        <property name="upper">100</property>
                        <property name="value">80</property>
                      </object>
                    </property>
                    <property name="draw-value">False</property>
                    <property name="hexpand">True</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">100</property>
                    <style>
                      <class name="dim-label"/>
                      <class name="caption"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">Recommended: 60–80% daily · 100% for travel</property>
                <style>
                  <class name="dim-label"/>
                  <class name="caption"/>
                </style>
                <property name="halign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <property name="homogeneous">True</property>
                <property name="spacing">8</property>
                <child>
                  <object class="GtkButton">
                    <property name="label" translatable="yes">Apply Threshold</property>
                    <style>
                      <class name="suggested-action"/>
                      <class name="pill"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton">
                    <property name="label" translatable="yes">Restore to 100%</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <child>
              <object class="AdwSwitchRow">
                <property name="title" translatable="yes">Dark Mode</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow">
                <property name="title" translatable="yes">Launch at login</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="vexpand">True</property>
          </object>
        </child>
        <child>
          <object class="GtkSeparator"/>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkLabel">
                <property name="label">○</property>
                <style>
                  <class name="dim-label"/>
                  <class name="caption"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">Ready</property>
                <style>
                  <class name="dim-label"/>
                  <class name="caption"/>
                </style>
                <property name="hexpand">True</property>
                <property name="xalign">0</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
