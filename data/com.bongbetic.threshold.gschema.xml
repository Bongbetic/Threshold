<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema path="/com/bongbetic/threshold/" id="com.bongbetic.threshold">
    <key name="dark-mode" type="b">
      <default>true</default>
      <summary>Dark mode</summary>
      <description>Whether to use dark color scheme.</description>
    </key>
    <key name="autostart" type="b">
      <default>false</default>
      <summary>Launch at login</summary>
      <description>Whether to launch the application automatically at login.</description>
    </key>
    <key name="minimize-to-tray" type="b">
      <default>true</default>
      <summary>Minimize to tray</summary>
      <description>Keep the application in the system tray when the window is closed.</description>
    </key>
    <key name="show-notifications" type="b">
      <default>true</default>
      <summary>Show notifications</summary>
      <description>Notify on threshold changes and alarms.</description>
    </key>
    <key name="accent-color" type="s">
      <default>'orange'</default>
      <choices>
        <choice value="orange"/>
        <choice value="blue"/>
        <choice value="green"/>
        <choice value="purple"/>
        <choice value="red"/>
      </choices>
      <summary>Accent color</summary>
      <description>UI accent color scheme (orange, blue, green, purple, red).</description>
    </key>
    <key name="compact-mode" type="b">
      <default>false</default>
      <summary>Compact mode</summary>
      <description>Reduce spacing and padding.</description>
    </key>
    <key name="title-percentage" type="b">
      <default>false</default>
      <summary>Show percentage in title</summary>
      <description>Display battery percentage in the window title.</description>
    </key>
    <key name="last-applied-time" type="x">
      <default>0</default>
      <summary>Last applied threshold timestamp</summary>
      <description>Unix timestamp of the last successful threshold apply.</description>
    </key>
    <key name="window-width" type="i">
      <default>980</default>
      <summary>Window width</summary>
      <description>Default window width in pixels.</description>
    </key>
    <key name="window-height" type="i">
      <default>680</default>
      <summary>Window height</summary>
      <description>Default window height in pixels.</description>
    </key>
    <key name="maximized" type="b">
      <default>false</default>
      <summary>Window maximized</summary>
      <description>Whether the window is maximized.</description>
    </key>
    <key name="charge-threshold" type="i">
      <default>80</default>
      <range min="20" max="100"/>
      <summary>Charge threshold</summary>
      <description>Battery charge limit as a percentage (20–100).</description>
    </key>
    <key name="migration-done" type="b">
      <default>false</default>
      <summary>Schema migration completed</summary>
      <description>Internal flag — true after the batteryguard → threshold migration has run.</description>
    </key>
  </schema>
</schemalist>
