                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">0</property>
                        <property name="spacing">8</property>
                        <style>
                          <class name="footer-bar"/>
                        </style>
                        <child>
                          <object class="GtkLabel" id="live_dot">
                            <property name="label">○</property>
                            <style>
                              <class name="dim-label"/>
                              <class name="caption"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="status_bar">
                            <property name="label" translatable="yes">Ready</property>
                            <style>
                              <class name="dim-label"/>
                              <class name="caption"/>
                            </style>
                            <property name="hexpand">true</property>
                            <property name="xalign">0</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>