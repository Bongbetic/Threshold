<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="BatteryGuardWindow" parent="AdwApplicationWindow">
    <property name="default-width">480</property>
    <property name="default-height">540</property>
    <property name="title" translatable="yes">MSI BatteryGuard</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="AdwHeaderBar">
            <child type="title">
              <object class="AdwWindowTitle">
                <property name="title" translatable="yes">BatteryGuard</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="label" translatable="yes">MSI BatteryGuard</property>
            <property name="margin-top">48</property>
            <property name="css-classes">title-1</property>
            <property name="halign">center</property>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
