                                        <property name="label" translatable="yes">—</property>
                                        <style>
                                          <class name="metadata-value"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">0</property>
                                    <style>
                                      <class name="settings-row"/>
                                    </style>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Design Capacity</property>
                                        <style>
                                          <class name="settings-row-title"/>
                                        </style>
                                        <property name="xalign">0</property>
                                        <property name="hexpand">true</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="design_capacity_label">
                                        <property name="label" translatable="yes">—</property>
                                        <style>
                                          <class name="metadata-value"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">0</property>
                                    <style>
                                      <class name="settings-row"/>
                                    </style>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Full Capacity</property>
                                        <style>
                                          <class name="settings-row-title"/>
