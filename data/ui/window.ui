                                          <object class="GtkToggleButton" id="swatch_orange">
                                            <property name="active">true</property>
                                            <property name="width-request">20</property>
                                            <property name="height-request">20</property>
                                            <style>
                                              <class name="accent-swatch"/>
                                              <class name="swatch-orange"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkToggleButton" id="swatch_blue">
                                            <property name="width-request">20</property>
                                            <property name="height-request">20</property>
                                            <style>
                                              <class name="accent-swatch"/>
                                              <class name="swatch-blue"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkToggleButton" id="swatch_green">
                                            <property name="width-request">20</property>
                                            <property name="height-request">20</property>
                                            <style>
                                              <class name="accent-swatch"/>
                                              <class name="swatch-green"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkToggleButton" id="swatch_purple">
                                            <property name="width-request">20</property>
                                            <property name="height-request">20</property>
                                            <style>
                                              <class name="accent-swatch"/>
                                              <class name="swatch-purple"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkToggleButton" id="swatch_red">
                                            <property name="width-request">20</property>
                                            <property name="height-request">20</property>
                                            <style>
                                              <class name="accent-swatch"/>
                                              <class name="swatch-red"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">1</property>
                                    <style>
                                      <class name="settings-row"/>
                                    </style>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">0</property>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="label" translatable="yes">Compact Mode</property>
                                            <style>
                                              <class name="settings-row-title"/>
                                            </style>
                                            <property name="xalign">0</property>
                                            <property name="hexpand">true</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkSwitch" id="compact_switch">
                                            <property name="valign">3</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Reduce spacing and padding</property>
                                        <style>
                                          <class name="settings-row-desc"/>
                                        </style>
                                        <property name="xalign">0</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">1</property>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">0</property>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="label" translatable="yes">Show percentage in title</property>
                                            <style>
                                              <class name="settings-row-title"/>
                                            </style>
                                            <property name="xalign">0</property>
                                            <property name="hexpand">true</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkSwitch" id="title_percentage_switch">
                                            <property name="valign">3</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Display battery % in window title</property>
                                        <style>
                                          <class name="settings-row-desc"/>
                                        </style>
                                        <property name="xalign">0</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">1</property>
                            <style>
                              <class name="panel"/>
                            </style>
                            <property name="hexpand">true</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Diagnostics</property>
                                <style>
                                  <class name="panel-title"/>
                                </style>
                                <property name="xalign">0</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">1</property>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">0</property>
                                    <style>
                                      <class name="settings-row"/>
                                    </style>
                                    <child>
